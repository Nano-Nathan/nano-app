{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "build",
    "rootDir": "..",
    "strict": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@nano-app/core": ["../core/index.ts"],
      "@nano-app/core/*": ["../core/*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["build", "node_modules"]
}
