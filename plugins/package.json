{
  "name": "@nano-app/plugins",
  "version": "0.0.0-semantic-release",
  "description": "Official plugins for @nano-app/backend",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./build/*/index.d.ts",
      "import": "./build/*/index.js"
    }
  },
  "files": [
    "build",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "tsx --env-file-if-exists=../.env --test tests/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "nano-app",
    "express",
    "plugins"
  ],
  "author": "Cristian Serrano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano-Nathan/nano-app.git",
    "directory": "plugins"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@nano-app/backend": ">=0.7.1"
  },
  "devDependencies": {
    "@nano-app/backend": "workspace:*",
    "@types/node": "^26.6.5",
    "glob": "^13.0.6",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
