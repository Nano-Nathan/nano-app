{
  "name": "@nano-app/plugins",
  "version": "0.0.0-semantic-release",
  "description": "Official plugins for @nano-app/backend",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./build/*/index.d.ts",
      "import": "./build/*/index.js"
    }
  },
  "files": [
    "build",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "tsx --env-file-if-exists=../.env --test --test-concurrency=1 tests/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "nano-app",
    "express",
    "plugins"
  ],
  "author": "Cristian Serrano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano-Nathan/nano-app.git",
    "directory": "plugins"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "peerDependencies": {
    "@nano-app/backend": ">=0.15.0",
    "drizzle-orm": "^1.0.0-rc.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@nano-app/backend": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-orm": "^1.0.0-rc.5",
    "glob": "^14.0.4",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "express-rate-limit": "^8.7.3"
  }
}
