{
  "name": "@nano-app/frontend",
  "version": "0.0.0-semantic-release",
  "description": "React provider for Next.js apps on top of @nano-app/backend",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "tsx --test ../core/tests/*.test.ts"
  },
  "keywords": [
    "nano-app",
    "next",
    "react",
    "store"
  ],
  "author": "Cristian Serrano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano-Nathan/nano-app.git",
    "directory": "frontend"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "next": ">=16.3.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
