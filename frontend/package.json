{
  "name": "@nano-app/frontend",
  "version": "0.0.0-semantic-release",
  "description": "React provider for Next.js apps on top of @nano-app/backend",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "browser": "./build/browser.js",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "tsx --test --test-force-exit tests/*.test.ts tests/*.test.tsx ../core/tests/*.test.ts"
  },
  "keywords": [
    "nano-app",
    "next",
    "react",
    "store"
  ],
  "author": "Cristian Serrano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano-Nathan/nano-app.git",
    "directory": "frontend"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "peerDependencies": {
    "@nano-app/backend": ">=0.20.0",
    "react": ">=19.0.0",
    "express": ">=5.0.0",
    "react-router": ">=8.5.0",
    "@react-router/dev": ">=8.5.0",
    "@react-router/express": ">=8.5.0",
    "@react-router/node": ">=8.5.0",
    "vite": ">=8.0.0"
  },
  "dependencies": {
    "glob": "^14.0.4",
    "jiti": "^2.7.0",
    "mobx": "^7.1.5",
    "mobx-react-lite": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@nano-app/backend": "workspace:^",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "express": "^5.3.0",
    "react-router": "8.5.1",
    "@react-router/dev": "8.5.1",
    "@react-router/express": "8.5.1",
    "@react-router/node": "8.5.1",
    "vite": "^8.3.8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@react-router/dev": {
      "optional": true
    }
  }
}
