// App schema of the crud plugin tests, in its own PostgreSQL schema: the backend suite truncates its
// tables. It lives here because a schema inside @nano-app/plugins counts as an official plugin's.
datasource db {
  provider = "postgresql"
  schemas  = ["crud_test"]
}

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

model Note {
  id       Int       @id @default(autoincrement())
  title    String
  comments Comment[]

  @@schema("crud_test")
}

// A string id and a relation
model Comment {
  id     String @id @default(uuid())
  text   String
  noteId Int
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@schema("crud_test")
}

// A model the app does not publish
model Secret {
  id Int @id @default(autoincrement())

  @@schema("crud_test")
}
