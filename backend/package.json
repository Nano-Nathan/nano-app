{
  "name": "@nano-app/backend",
  "version": "0.0.0-semantic-release",
  "description": "Express server with file-convention routes, plugins and an optional PostgreSQL layer",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "express",
    "backend",
    "plugins",
    "file-based-routing",
    "postgresql",
    "prisma"
  ],
  "author": "Cristian Serrano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano-Nathan/nano-app.git",
    "directory": "backend"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "glob": "^13.0.6",
    "helmet": "^8.2.0",
    "jiti": "^2.7.0",
    "morgan": "^1.11.0"
  },
  "peerDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.22.0"
  },
  "peerDependenciesMeta": {
    "@prisma/adapter-pg": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "bin": {
    "nano-app": "build/nano-app.js"
  }
}
