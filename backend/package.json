{
  "name": "@nano-app/backend",
  "version": "0.0.0-semantic-release",
  "description": "Express server with file-convention routes, plugins and an optional PostgreSQL layer",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "tsx --env-file-if-exists=../.env --test tests/*.test.ts ../core/tests/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "express",
    "backend",
    "plugins",
    "file-based-routing",
    "postgresql",
    "drizzle"
  ],
  "author": "Cristian Serrano",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano-Nathan/nano-app.git",
    "directory": "backend"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "glob": "^14.0.4",
    "helmet": "^8.3.0",
    "jiti": "^2.7.0",
    "morgan": "^1.12.1"
  },
  "peerDependencies": {
    "better-auth": "^1.7.18",
    "drizzle-orm": "^1.0.0-rc.5",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.20.0",
    "better-auth": "^1.7.18",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-orm": "^1.0.0-rc.5",
    "pg": "^8.23.1",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
