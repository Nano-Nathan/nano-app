{
  "name": "nano-app-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @nano-app/backend dev",
    "format": "pnpm dlx prettier@3 --write \"{core,backend}/**/*.ts\"",
    "format:check": "pnpm dlx prettier@3 --check \"{core,backend}/**/*.ts\""
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
