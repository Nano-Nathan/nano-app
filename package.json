{
  "name": "nano-app-monorepo",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @nano-app/backend dev",
    "format": "prettier --write \"{core,backend,plugins,frontend}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{core,backend,plugins,frontend}/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
