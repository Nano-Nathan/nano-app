{
  "name": "nano-app-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @nano-app/backend dev",
    "format": "prettier --write \"{core,backend,plugins}/**/*.ts\"",
    "format:check": "prettier --check \"{core,backend,plugins}/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
